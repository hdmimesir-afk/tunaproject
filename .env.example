# Salin menjadi .env.local untuk lokal. Di Vercel, isi per lingkungan (Preview = proyek Supabase uji, Production = proyek produksi).
# Kunci diambil dari dialog Connect di dashboard Supabase. Pakai kunci baru (sb_publishable_ / sb_secret_), bukan anon/service_role.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Hanya server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Asisten AI lewat OpenRouter (opsional). Tanpa kunci ini, Asisten tetap menampilkan pertanyaan cepat dari data.
# Hanya server; jangan diberi awalan NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Model Asisten (bawaan anthropic/claude-sonnet-4.5). Pilih model yang mendukung pemanggilan alat (tool calling).
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Alamat situs untuk atribusi OpenRouter (opsional).
# NEXT_PUBLIC_SITE_URL=https://katalis.example.com
